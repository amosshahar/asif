# Copy to deploy/.env and fill in values

# EC2
EC2_HOST=ec2-3-92-164-103.compute-1.amazonaws.com
EC2_USER=ec2-user
SSH_KEY=~/.ssh/amos-keypair.pem
SERVER_TARGET_DIR=/home/ec2-user/asif-server

# S3 + CloudFront (admin UI)
ADMIN_S3_BUCKET=asif-admin-frontend
ADMIN_CF_ID=                        # fill after creating CF distribution

# API CloudFront
API_CF_ID=                          # fill after creating CF distribution

# Public URLs (used at build time)
# Live API hostname (api.asif.tulidu.com is not in DNS — use asif-api)
VITE_API_URL=https://asif-api.tulidu.com
