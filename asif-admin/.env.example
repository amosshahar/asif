# ASIF API — production / custom: full URL (e.g. https://asif-api.example.com).
# Local dev: omit to use /asif-api (Vite proxy to 127.0.0.1:3002 — avoids localhost:3002 browser issues).
# VITE_API_URL=https://asif-api.example.com
#
# Dev server port is 5174 (vite.config.ts) so Tulidu Sport can keep 5173.

# Firebase Web — same project as asif-server FIREBASE_* (e.g. tulidu-prod if you share Tulidu keys)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

