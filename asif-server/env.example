PORT=3002

# Copy to .env in this directory. Loaded automatically (dotenv) when you run npm run dev / npm start from asif-server.

# WooCommerce REST API (HTTPS store URL, no trailing slash)
# Keys: WP Admin → WooCommerce → Settings → Advanced → REST API
WC_STORE_URL=
WC_CONSUMER_KEY=
WC_CONSUMER_SECRET=
# Processing + slug for Hebrew "ממתין לליקוט" (replace waiting-for-pick with your WC custom status slug)
WC_ORDER_STATUSES=processing,waiting-for-pick

# Optional: WC order meta keys (comma-separated, first match wins) for לוגיסטיקה / סינון בממשק מנהל
# WC_META_KEYS_DISTRIBUTION_AREA=אזור חלוקה,distribution_area,_distribution_area,shipping_area
# WC_META_KEYS_DELIVERY_DATE=תאריך חלוקה,delivery_date,_delivery_date,Delivery Date
# WC_META_KEYS_DELIVERY_TIME_FROM=שעת חלוקה מתי,delivery_time_from,_delivery_time_from
# WC_META_KEYS_DELIVERY_TIME_TO=שעת חלוקה עד,delivery_time_to,_delivery_time_to
# Optional: meta key whose value is one string `DD/MM/YYYY - HH:mm - HH:mm` (discover real key via WC REST on a sample order).
# If unset, the server still scans all order meta for that pattern (covers many “shipping slot” plugins).
# WC_META_KEYS_COMBINED_SHIPPING_SLOT=your_plugin_internal_key

# Line-item meta (location, pieces, total kg, image URL) uses built-in Hebrew + English key lists in
# mapWcOrder.ts — extend there if your store uses different checkout field keys.

# Firestore — REQUIRED (no JSON file storage)
# Uses ONLY asif_orders + asif_users — see docs/ASIF-FIRESTORE-ENTITIES.md
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Web admin: emails must exist in Firestore `asif_admins` only (see docs/ASIF-FIRESTORE-ENTITIES.md).

# 1 = log every HTTP request to this terminal (noisy).
# ASIF_DEBUG_HTTP=1

# --- Comax (optional) — API login only; tester is in asif-admin → Comax (POST /admin/comax/*) ---
# משתמש בלבד או LoginID מלא אם כבר כולל ארגון\משתמש:
# COMAX_LOGIN_ID=
# COMAX_LOGIN_PASSWORD=
# אם בכניסה ל־Comax יש שדה “ארגון” נפרד (למשל אסיף1), אפשר למלא כאן — השרת ישלח LoginID = ORG\COMAX_LOGIN_ID
# COMAX_ORGANIZATION=
#
# CLI: auth from .env only; pass dates/store/mobile/email/customer id as arguments (see script headers).
# npm run comax:test | comax:curl | comax:curl:orders | comax:curl:items | comax:curl:all
